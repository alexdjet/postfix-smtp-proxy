myhostname = mail.miroznai.loc
mydomain = miroznai.loc
myorigin = $mydomain

mydestination = $myhostname

smtpd_banner = $myhostname ESMTP Mail Server
postscreen_greet_banner = $smtpd_banner
smtpd_relay_restrictions = permit_mynetworks permit_sasl_authenticated defer_unauth_destination


#alias_maps = hash:/etc/aliases
#alias_database = hash:/etc/aliases

# Global relayhost for all mail
relayhost = [smtp.provider1.lan]:587

sender_canonical_maps = hash:/etc/postfix/sender_canonical
sender_canonical_classes = envelope_sender, header_sender

# maps, если отправитель есть в этой карте, используется указанный для него relayhost, игнорируя глобальный
sender_dependent_relayhost_maps = hash:/etc/postfix/sender_relay

smtp_sender_dependent_authentication = yes

# TLS для входящих
smtpd_tls_cert_file=/etc/ssl/certs/ssl-cert-snakeoil.pem
smtpd_tls_key_file=/etc/ssl/private/ssl-cert-snakeoil.key
smtpd_use_tls=yes
smtpd_tls_session_cache_database = btree:${data_directory}/smtpd_scache
smtp_tls_session_cache_database = btree:${data_directory}/smtp_scache

# SASL и TLS для исходящих
smtp_sasl_auth_enable = yes
smtp_sasl_security_options = noanonymous
smtp_sasl_password_maps = hash:/etc/postfix/sasl_passwd
smtp_tls_security_level = encrypt
smtp_tls_mandatory_protocols = !SSLv2,!SSLv3,!TLSv1,!TLSv1.1
smtp_tls_ciphers = high
smtp_tls_session_cache_database = btree:${data_directory}/smtp_scache

mynetworks = 127.0.0.0/8 192.168.65.0/24
mailbox_size_limit = 0
recipient_delimiter = +
inet_interfaces = all
inet_protocols = ipv4
smtp_generic_maps = hash:/etc/postfix/generic
maillog_file = /var/log/mail.log
minimal_backoff_time = 3600s
maximal_backoff_time = 21600s
queue_run_delay = 1800s
maximal_queue_lifetime = 5d
notify_classes = bounce, 2bounce, delay, policy, protocol, resource, software
biff = no
append_dot_mydomain = no
readme_directory = no
